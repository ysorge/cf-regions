{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ysorge/cf-regions/schemas/profile-manifest.schema.json",
  "title": "cf-regions spatial interpretation profile manifest",
  "description": "Self-describing identity, compatibility, lookup behavior, geometry resources, hierarchy resource, provenance, and limitations for one immutable profile version.",
  "type": "object",
  "required": ["schema_version", "profile", "supported_cf_versions", "generated_on", "crs", "lookup", "representations", "hierarchy", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {
      "type": "object",
      "required": ["id", "version", "title", "description", "basis", "scope", "license", "homepage"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "basis": {
          "type": "string",
          "minLength": 1,
          "description": "Brief informal summary of the vocabularies, datasets, or scientific conventions on which this interpretation is based. Detailed provenance belongs in sources and feature metadata."
        },
        "scope": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "homepage": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "supported_cf_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Exact CF releases for which this profile provides complete geometry and compatible hierarchy.", "items": {"type": "string", "minLength": 1}},
    "generated_on": {"type": "string", "format": "date"},
    "crs": {"const": "OGC:CRS84"},
    "lookup": {
      "description": "Deterministic behavior used when mapping coordinates to interpreted regions.",
      "type": "object",
      "required": ["behavior_version", "geometry_resolution", "default_geometry_resolution", "area_predicate", "boundary_inclusive", "section_method"],
      "properties": {
        "behavior_version": {"type": "string", "minLength": 1},
        "geometry_resolution": {"type": "string", "minLength": 1},
        "default_geometry_resolution": {"type": "string", "minLength": 1},
        "area_predicate": {"const": "covers"},
        "boundary_inclusive": {"const": true},
        "section_method": {"const": "minor_great_circle_distance"}
      },
      "additionalProperties": false
    },
    "representations": {
      "description": "Named rendering representations of the same spatial interpretation; lookup uses lookup.geometry_resolution.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "description", "geometry_file", "feature_count", "processing"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "geometry_file": {"type": "string", "minLength": 1, "description": "POSIX-style path relative to this manifest."},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Optional SHA-256 integrity check for the exact geometry file bytes."},
          "feature_count": {"type": "integer", "minimum": 1},
          "processing": {
            "type": "object",
            "required": ["method", "parameters"],
            "properties": {
              "method": {"type": "string", "minLength": 1},
              "parameters": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "hierarchy": {
      "description": "Profile-owned hierarchy resource and its summary provenance.",
      "type": "object",
      "required": ["name", "version", "date", "url", "hierarchy_file", "edge_count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "hierarchy_file": {"type": "string", "minLength": 1, "description": "POSIX-style path relative to this manifest."},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Optional SHA-256 integrity check for the exact hierarchy file bytes."},
        "edge_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sources": {
      "description": "Profile-level bibliography and licensing summary; feature and hierarchy-edge metadata provide result-level provenance.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "license_url": {"type": "string", "format": "uri"},
          "doi": {"type": "string", "minLength": 1},
          "scale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "description": "Important uncertainty, fitness-for-use, gap, overlap, and interpretation notices.", "items": {"type": "string"}},
    "input_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  },
  "additionalProperties": false
}
