{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ysorge/cf-regions/schemas/lookup-index.schema.json",
  "title": "cf-regions compiled lookup index",
  "description": "Generated index for optional lazy access to a packed WKB representation. Profile authors normally create this with tools/lookup_artifact.py rather than by hand.",
  "type": "object",
  "required": ["schema_version", "format", "source_sha256", "feature_count", "features"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "format": {"const": "wkb-pack-v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_count": {"type": "integer", "minimum": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "geometry_type", "bounds", "offset", "length", "properties"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "geometry_type": {"type": "string", "minLength": 1},
          "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "offset": {"type": "integer", "minimum": 0},
          "length": {"type": "integer", "minimum": 1},
          "properties": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
